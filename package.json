{
  "name": "juejin-pins",
  "displayName": "掘金沸点",
  "description": "在 VSCode 中浏览掘金沸点，查看详情和评论",
  "version": "0.2.0",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Social", "Other"],
  "activationEvents": ["onCommand:juejin-pins.openView"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "juejin-pins.openView",
        "title": "打开掘金沸点"
      }
    ],
    "menus": {
      "command/juejin-pins.openView": [
        {
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p ."
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}